import subprocess
import os
from IPython.display import Image, display

# 定義要在 Conda 環境內跑的獨立指令稿
script_content = """
import os
import sys
import json
import urllib.request
import pandas as pd

# 確保動態鏈接庫路徑正確
os.environ["LD_LIBRARY_PATH"] = "/usr/local/lib:" + os.environ.get("LD_LIBRARY_PATH", "")
import pygmt

OUT = "volcanoes_hotspots.png"
print("正在下載數據...")

# 1. 下載火山數據
rows, page = [], 1
while True:
    url = f"https://www.ngdc.noaa.gov/hazel/hazard-service/api/v1/volcanolocs?itemsPerPage=200&page={page}"
    try:
        with urllib.request.urlopen(url) as response:
            data = json.load(response)
        rows += data["items"]
        if page >= data["totalPages"]:
            break
        page += 1
    except Exception as e:
        print("下載中斷或完成:", e)
        break

volc = pd.DataFrame(rows).dropna(subset=["latitude", "longitude"])

# 2. 下載熱點數據
hot = pd.read_csv(pygmt.which("@hotspots.txt", download="c"), sep=r"\\s+", comment="#", header=None,
                  usecols=[0, 1], names=["lon", "lat"])
print(f"數據加載成功！火山: {len(volc)} 筆, 熱點: {len(hot)} 筆")

# 3. 初始化繪圖
fig = pygmt.Figure()
pygmt.config(FONT_ANNOT_PRIMARY="8p", FONT_LABEL="9p", FONT_TITLE="11p", MAP_FRAME_TYPE="plain")

# (a) 全球圖
fig.grdimage(grid="@earth_relief_10m", region="d", projection="N150/20c", cmap="geo", shading="+a-45+nt0.4",
             frame=["+tHolocene volcanoes (NCEI/GVP) and hotspots (Mueller et al. 1993)", "g30"])
fig.coast(shorelines="0.15p,gray30")
fig.plot(x=volc.longitude, y=volc.latitude, style="t0.12c", fill="red", pen="0.1p,black")
fig.plot(x=hot.lon, y=hot.lat, style="a0.35c", fill="yellow", pen="0.4p,black")
fig.plot(x=[-175], y=[-75], style="t0.25c", fill="red", pen="0.1p,black")
fig.text(x=-170, y=-75, text="Holocene volcano", justify="ML", font="8p")
fig.plot(x=[-175], y=[-82], style="a0.4c", fill="yellow", pen="0.4p,black")
fig.text(x=-170, y=-82, text="Hotspot", justify="ML", font="8p")

# 地震快速下載輔助函式
def quakes(region, start, minmag):
    q = (f"format=csv&starttime={start}&minmagnitude={minmag}&minlongitude={region[0]}"
         f"&maxlongitude={region[1]}&minlatitude={region[2]}&maxlatitude={region[3]}")
    return pd.read_csv("https://earthquake.usgs.gov/fdsnws/event/1/query?" + q).dropna(
        subset=["longitude", "latitude", "depth", "mag"])

# (b) 日本子圖
fig.shift_origin(yshift="-9.0c", xshift="0.5c")
reg_jp = [128, 150, 30, 46]
q_jp = quakes(reg_jp, "2010-01-01", 4.5).sort_values("depth", ascending=False)
fig.grdimage(grid=pygmt.datasets.load_earth_relief("02m", region=reg_jp), region=reg_jp, projection="M9c",
             cmap="geo", shading="+a-45+nt0.5", frame=["WSne+tJapan: volcanic arc vs earthquake depth", "a5f1"])
fig.coast(shorelines="0.3p,gray20", resolution="i")

pygmt.makecpt(cmap="rainbow", series=[0, 700, 100])
fig.plot(x=q_jp.longitude, y=q_jp.latitude, style="c0.06c", fill=q_jp.depth, cmap=True, transparency=50)
v_jp = volc[(volc.longitude.between(*reg_jp[:2])) & (volc.latitude.between(*reg_jp[2:]))]
fig.plot(x=v_jp.longitude, y=v_jp.latitude, style="t0.22c", fill="white", pen="0.6p,black")
fig.basemap(map_scale="jBL+c38+w500k+o0.3c/0.3c+f+lkm")
fig.text(text=f"{len(v_jp)} volcanoes; Depth: Red-Blue Scale",
         position="TL", offset="0.15c/-0.15c", font="6p", fill="white@30")

# (c) 夏威夷子圖
fig.shift_origin(xshift="10.0c")
reg_hi = [-162, -152, 17, 24]
q_hi = quakes(reg_hi, "2010-01-01", 4.0).sort_values("depth", ascending=False)
fig.grdimage(grid=pygmt.datasets.load_earth_relief("01m", region=reg_hi), region=reg_hi, projection="M9c",
             cmap="geo", shading="+a-45+nt0.5", frame=["WSne+tHawaii: hotspot, no boundary", "a2f1"])
fig.coast(shorelines="0.3p,gray20", resolution="h")
fig.plot(x=q_hi.longitude, y=q_hi.latitude, style="c0.08c", fill=q_hi.depth, cmap=True, transparency=40)
v_hi = volc[(volc.longitude.between(*reg_hi[:2])) & (volc.latitude.between(*reg_hi[2:]))]
fig.plot(x=v_hi.longitude, y=v_hi.latitude, style="t0.25c", fill="white", pen="0.6p,black")
h_hi = hot[(hot.lon.between(*reg_hi[:2])) & (hot.lat.between(*reg_hi[2:]))]
fig.plot(x=h_hi.lon, y=h_hi.lat, style="a0.6c", fill="yellow", pen="0.6p,black")
fig.basemap(map_scale="jBL+c20+w200k+o0.3c/0.3c+f+lkm")
fig.text(text=f"{len(v_hi)} volcanoes, {len(h_hi)} hotspot; all shallow",
         position="TL", offset="0.15c/-0.15c", font="6p", fill="white@30")

# 儲存
fig.savefig(OUT, dpi=150)
print("[SUCCESS] 成功生成影像:", OUT)
"""

# 將指令稿寫入本地臨時檔案
script_file = "render_volc.py"
with open(script_file, "w", encoding="utf-8") as f:
    f.write(script_content)

# 修正 Conda 預設 Python 的路徑
conda_python = "/usr/local/bin/python"
print("正在調用 Conda (Python) 沙盒引擎繪製圖片...")

env = os.environ.copy()
env["LD_LIBRARY_PATH"] = "/usr/local/lib:" + env.get("LD_LIBRARY_PATH", "")

result = subprocess.run(
    [conda_python, script_file],
    capture_output=True,
    text=True,
    env=env
)

print(result.stdout)
if result.stderr:
    print("錯誤資訊:", result.stderr)

# 展示生成結果
OUT = "volcanoes_hotspots.png"
if os.path.exists(OUT):
    print("繪製完成！正在顯示最終地圖：")
    display(Image(filename=OUT))
else:
    print("未成功產出地圖檔案，請檢查上方報錯。")
